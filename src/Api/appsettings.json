{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Observability": {
    "ServiceName": "kart-analytics-service",
    "Otlp": {
      "Endpoint": "http://localhost:4317"
    }
  },
  "ConnectionStrings": {
    "AnalyticsDb": "Host=localhost;Port=5432;Database=kart_analytics;Username=postgres;Password=postgres"
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "kart_analytics"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "kart-analytics-service",
    "MaxRetryAttempts": 3
  },
  "Jwt": {
    "Issuer": "kart-identity-service",
    "JwksUri": "http://kart-identity-service/.well-known/jwks.json"
  },
  "AllowedHosts": "*"
}
