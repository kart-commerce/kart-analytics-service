<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <!-- Pinned explicitly, matching Infrastructure's own pin exactly - JwtBearer's own transitive
         dependency otherwise wins as "primary" over Infrastructure's higher version, which fails
         the build (CS1705) rather than silently floating up (kart-recommendation-service precedent). -->
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.0.2" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.0.2" />
  </ItemGroup>

  <!--
    kart-conventions.md Observability section: Kart.Shared.Observability wires Serilog + the
    OpenTelemetry SDK behind one DI call - never reimplemented per service. Kart.Shared.ErrorHandling
    wires the single global exception handler + ProblemDetails factory. Kart.Shared.Auditing supplies
    the IAuditLogWriter contract this service's own Postgres-backed writer implements - a REAL sink,
    not the Null default, per this service's explicit BRD Section 24.3 audit-trail requirement.
    Kart.Shared.Configuration wires the GlobalConfig external-secrets-file bootstrap.
  -->
  <ItemGroup>
    <PackageReference Include="Kart.Shared.Configuration" Version="0.2.0" />
    <PackageReference Include="Kart.Shared.Observability" Version="0.4.0" />
    <PackageReference Include="Kart.Shared.ErrorHandling" Version="0.1.0" />
    <PackageReference Include="Kart.Shared.Auditing" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Kart.Analytics.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Kart.Analytics.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    contracts/api-contract.yaml + event-contract.md + message-bus-manifest.json are this service's
    own local copies of kart-platform's approved design docs (reference only - source of truth
    stays in kart-platform/docs/services/kart-analytics-service/), mirroring kart-identity-service's
    "contracts/" convention of shipping them alongside the built artifact.
  -->
  <ItemGroup>
    <Content Include="..\..\contracts\message-bus-manifest.json" Link="message-bus-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
